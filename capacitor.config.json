{
  "appId": "com.azienda.permessi",
  "appName": "Gestione Permessi",
  "webDir": "public",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "*"
    ],
    "hostname": "localhost",
    "iosScheme": "capacitor",
    "url": "https://localhost:8443"
  },
  "android": {
    "buildOptions": {
      "keystorePath": "android/app/my-release-key.keystore",
      "keystoreAlias": "my-key-alias"
    },
    "allowMixedContent": true,
    "useLegacyBridge": false,
    "webContentsDebuggingEnabled": true,
    "captureInput": true,
    "initialFocus": true,
    "hardwareBackButton": true,
    "persistWebView": false
  },
  "ios": {
    "scheme": "Gestione Permessi",
    "allowsInlineMediaPlayback": true,
    "scrollEnabled": true,
    "backgroundColor": "#2c3e50"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#2c3e50",
      "androidSplashResourceName": "splash",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "dark",
      "backgroundColor": "#2c3e50"
    },
    "Keyboard": {
      "resize": "body",
      "style": "dark",
      "resizeOnFullScreen": true
    },
    "App": {
      "launchUrl": "https://localhost:8443"
    },
    "CapacitorHttp": {
      "enabled": true
    }
  }
}