# ========================================
# WKF SUITE - CONFIGURAZIONE AMBIENTE
# ========================================
# ISTRUZIONI:
# 1. Copia questo file come ".env" nella root del progetto
# 2. Sostituisci i valori di esempio con le tue chiavi reali
# 3. NON committare mai il file .env (già protetto da .gitignore)

# ========================================
# 🔑 STRIPE PAYMENT KEYS
# ========================================

# Chiave pubblicabile Stripe (lato frontend)
# Ottienila da: https://dashboard.stripe.com/apikeys
# Esempio: pk_live_51aBcDeFgHiJkLmNoPqRsTuVwXyZ...
STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY_HERE

# Chiave segreta Stripe (lato backend - MANTIENI PRIVATA!)
# Ottienila da: https://dashboard.stripe.com/apikeys
# Esempio: sk_live_51aBcDeFgHiJkLmNoPqRsTuVwXyZ...
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY_HERE

# Webhook Secret per verificare eventi Stripe
# Ottienilo da: https://dashboard.stripe.com/webhooks
# Esempio: whsec_aBcDeFgHiJkLmNoPqRsTuVwXyZ...
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET_HERE

# ========================================
# 💰 CONFIGURAZIONE PRODOTTI
# ========================================

# Price ID prodotto da Stripe Dashboard
# Ottienilo da: https://dashboard.stripe.com/products
# Esempio: price_1aBcDeFgHiJkLmNo...
STRIPE_PRICE_ID=YOUR_STRIPE_PRICE_ID_HERE

# Prezzo WKF Suite PRO (in centesimi - es: 2000 = €20.00)
WKF_PRO_PRICE=2000

# Valuta
WKF_PRO_CURRENCY=EUR

# ========================================
# 🌐 CONFIGURAZIONE SERVER
# ========================================

# Porta server (default: 3000)
PORT=3000

# Ambiente (development, production)
NODE_ENV=production

# URL base dell'applicazione
BASE_URL=http://localhost:3000

# ========================================
# 📧 EMAIL (opzionale - per notifiche PRO)
# ========================================

# SMTP Server
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ========================================
# 🔐 SICUREZZA
# ========================================

# Secret per sessioni Express (genera una stringa random)
SESSION_SECRET=CHANGE_THIS_TO_RANDOM_STRING

# ========================================
# 📊 DATABASE
# ========================================

# Path database SQLite
DB_PATH=./data/database.sqlite

# ========================================
# 🐛 DEBUG (opzionale)
# ========================================

# Abilita logging dettagliato (true/false)
DEBUG_MODE=false
